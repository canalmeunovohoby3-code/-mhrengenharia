# ==========================================================================
# MHR — Manutenção Industrial e Engenharia
# Configuração para hospedagem Apache (Hostinger) — mhrengenharia.com
# --------------------------------------------------------------------------
# Este site é ESTÁTICO (HTML/CSS/JS) e MULTIPÁGINA: cada página é um arquivo
# real (index.html, servicos.html, segmentos.html, contato.html, ...) e existe
# uma página 404 própria. Por isso o "fallback de SPA" NÃO é usado aqui: URLs
# inexistentes devem cair no 404.html (é para isso que serve o ErrorDocument).
#
# Se algum dia este domínio passar a hospedar um app de PÁGINA ÚNICA
# (React/Vite, por exemplo), descomente o bloco "FALLBACK DE SPA" no final.
# ==========================================================================

# --- Página inicial e listagem de diretórios ------------------------------
DirectoryIndex index.html
Options -Indexes

# --- Codificação ----------------------------------------------------------
AddDefaultCharset UTF-8

# --- HTTPS: redireciona http:// para https:// -----------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Domínio canônico: descomente UMA das duas opções ---------------------
# (a) Forçar SEM "www" (recomendado se o site é publicado em mhrengenharia.com)
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# </IfModule>
#
# (b) Forçar COM "www" (use apenas se preferir www.mhrengenharia.com)
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Página 404 (o arquivo 404.html já existe na raiz) --------------------
ErrorDocument 404 /404.html

# --- Compressão (Gzip) ----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --- Cache do navegador ---------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# --- FALLBACK DE SPA (NÃO necessário neste site) --------------------------
# Descomente SOMENTE se o domínio passar a servir um app de página única
# (React/Vite, Next export, etc.), em que todas as rotas são resolvidas pelo
# index.html. Com o site estático atual, deixar isso ativo faria as URLs
# erradas mostrarem a Home em vez da página 404.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteBase /
#   RewriteRule ^index\.html$ - [L]
#   RewriteCond %{REQUEST_FILENAME} !-f
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteRule . /index.html [L]
# </IfModule>
